
.register-container {
    max-width: 400px;
    margin: 40px auto;
    padding: 25px;
    background: #191919;
    border: 1px solid #ff0000;
    border-radius: 10px;
    text-align: center;
}

.register-container h2 {
    color: red;
    margin-bottom: 25px;
}

.register-container input {
    width: 100%;
    padding: 14px;
    margin-bottom: 15px;
    background: #0b0b0b;
    color: white;
    border: 1px solid #444;
    border-radius: 5px;
}

.register-container button {
    width: 100%;
    margin-bottom: 20px;
}

.register-container a {
    color: red;
}
